# Doxygen settings for doxy_check. doxy_check.sh replaces INPUT with the files and folders it is
# given, and writes warnings and output (as XML, since Doxygen needs one output format) to a temporary
# folder; everything else applies as set here.
PROJECT_NAME           = "Documentation checks"
INPUT                  = src include
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.h *.cc *.cpp *.hpp

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC  = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
QUIET                  = YES
