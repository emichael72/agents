# User unit for the developer quiz service. Install with:
#   ln -sf ~/projects/agents/tools/mr_gate/mr-gate.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now mr-gate
# For the openai profile, put OPENAI_API_KEY=... in ~/.config/mr-gate.env and add --profile openai.
[Unit]
Description=Developer quiz service (agents/tools/mr_gate)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/agents/tools/mr_gate
EnvironmentFile=-%h/.config/mr-gate.env
ExecStart=%h/projects/agents/tools/mr_gate/mr_gate.sh serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
