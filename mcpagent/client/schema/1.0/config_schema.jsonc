/*

	MCP Client Configuration Schema
	-------------------------------

    Note: This file uses JSONC — an extended JSON format that supports inline comments and multi-line strings.
    This allows for improved readability and documentation which are not valid standard JSON.

	This schema validates configuration files for the MCP client. It defines:

	- Global settings
	- Where the chat client finds its model profiles and instructions
	- A list of servers, each describing its connection method (HTTP or STDIO).
	- Optional capabilities that declare server-specific requirements.
*/

{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "MCP Client Configuration",
	"type": "object",
	"properties": {
		"instructions_file": {
			"type": "string",
			"description": "JSON file whose \"instructions\" lines form the model's instructions (relative to the config file)."
		},
		"models_file": {
			"type": "string",
			"description": "JSON file with the model profiles (\"default\" and \"profiles\"), relative to the config file."
		},
		"agent_file": {
			"type": "string",
			"description": "JSON file with the agent loop settings (\"max_tool_calls\"), relative to the config file."
		},
		"output_file": {
			"type": "string",
			"description": "JSON file with the terminal layout (\"width\", \"show_time\"), relative to the config file."
		},
		"log_level": {
			"type": "string",
			"enum": [
				"DEBUG",
				"INFO",
				"WARNING",
				"ERROR"
			],
			"description": "Global logging level for the MCP client."
		},
		"schema_version": {
			"type": "string",
			"description": "Define schema version to validate against",
			"default": "1.0"
		},
		"server_id": {
			"type": "string",
			"description": "Unique identifier for the server."
		},
		"debug_json_box": {
			"type": "boolean",
			"description": "Show extended JSON related debugging information",
			"default": false
		},
		"servers": {
			"type": "array",
			"description": "List of MCP servers to manage.",
			"items": {
				"type": "object",
				"required": [
					"server_id",
					"description",
					"transport",
					"config"
				],
				"properties": {
					"enabled": {
						"type": "boolean",
						"description": "Allow to quickly ignore a server entry in the list.",
						"default": true
					},
					"server_id": {
						"type": "string",
						"description": "Unique identifier for the server."
					},
					"description": {
						"type": "string",
						"description": "Brief description of the server role and capabilities."
					},
					"transport": {
						"type": "string",
						"enum": [
							"HTTP",
							"STDIO"
						],
						"description": "Transport type: HTTP or STDIO."
					},
					"health_check_interval": {
						"type": "number",
						"minimum": 0,
						"description": "Optional: seconds between automatic health checks."
					},
					"capabilities": {
						"type": "object",
						"description": "Optional server-specific capabilities.",
						"properties": {
							"requires_session": {
								"type": "boolean",
								"description": "Whether this server requires session_id handling.",
								"default": false
							},
							"initialize_via": {
								"type": "string",
								"enum": [
									"rpc",
									"sse"
								],
								"description": "How the initialize RPC must be sent: 'rpc' (default) or 'sse'.",
								"default": "rpc"
							}
						},
						"additionalProperties": false
					},
					"config": {
						"oneOf": [
							{
								"type": "object",
								"required": [
									"url"
								],
								"properties": {
									"url": {
										"type": "string",
										"format": "uri",
										"description": "Base URL of the MCP HTTP server."
									},
									"headers": {
										"type": "object",
										"additionalProperties": {
											"type": "string"
										},
										"description": "Optional HTTP headers."
									},
									"sse_url": {
										"type": "string",
										"format": "uri",
										"description": "Optional SSE endpoint URL."
									}
								},
								"additionalProperties": false
							},
							{
								"type": "object",
								"required": [
									"command"
								],
								"properties": {
									"command": {
										"type": "array",
										"items": {
											"type": "string"
										},
										"minItems": 1,
										"description": "Subprocess command and arguments."
									},
									"env": {
										"type": "object",
										"additionalProperties": {
											"type": "string"
										},
										"description": "Optional environment variables for the subprocess."
									}
								},
								"additionalProperties": false
							}
						]
					}
				},
				"additionalProperties": false
			}
		}
	},
	"required": [
		"log_level",
		"servers"
	],
	"additionalProperties": false
}
