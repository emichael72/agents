/*
	MCPAgent Configuration Schema
	-----------------------------

	Validates mcpagent.jsonc (JSONC: comments and trailing commas allowed). The file has two
	sections, each read by its own entry point:

	- server: the MCP server (python mcp/server.py): name, listener, and the tools it serves.
	- client: the agent (python mcp/client.py): log level, the shared context files, and the
	  MCP servers whose tools the model gets.

	Neither section is required here; each entry point reports its own section when missing.
	Paths are relative to the repository root.
*/

{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "MCPAgent Configuration",
	"type": "object",
	"properties": {
		"server": {"$ref": "#/definitions/server"},
		"client": {"$ref": "#/definitions/client"}
	},
	"additionalProperties": false,

	"definitions": {
		"server": {
			"type": "object",
			"required": ["mcp_server_port"],
			"properties": {
				"project_name": {
					"type": "string",
					"description": "Server name sent to clients in the initialize handshake."
				},
				"description": {
					"type": "string",
					"description": "What the server is for."
				},
				"version": {
					"type": "string",
					"description": "Server version sent to clients in the initialize handshake."
				},
				"mcp_server_port": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535,
					"description": "TCP port the server listens on."
				},
				"mcp_server_bind_address": {
					"type": "string",
					"description": "Address to bind; \"0.0.0.0\" binds to all interfaces."
				},
				"allowed_origins": {
					"type": "array",
					"items": {"type": "string"},
					"description": "Browser origins allowed to call the server."
				},
				"show_usage_examples": {
					"type": "boolean",
					"description": "Print usage examples on startup."
				},
				"tools_dir": {
					"type": "string",
					"description": "Folder of <tool>/tool.json manifests, relative to the repository root."
				},
				"tools_env": {
					"type": "object",
					"additionalProperties": {"type": "string"},
					"description": "Environment variables added to every tool."
				},
				"tools": {
					"type": "object",
					"description": "Extra inline tool definitions, shaped like tool.json manifests."
				}
			},
			"additionalProperties": false
		},

		"client": {
			"type": "object",
			"properties": {
				"log_level": {
					"type": "string",
					"enum": ["DEBUG", "INFO", "WARNING", "ERROR"],
					"description": "Logging level for the MCP client."
				},
				"debug_json_box": {
					"type": "boolean",
					"description": "Show extended JSON debugging information.",
					"default": false
				},
				"instructions_file": {
					"type": "string",
					"description": "JSON file whose \"instructions\" lines form the model's instructions."
				},
				"models_file": {
					"type": "string",
					"description": "JSON file with the model profiles (\"default\" and \"profiles\")."
				},
				"agent_file": {
					"type": "string",
					"description": "JSON file with the agent loop settings (\"max_tool_calls\")."
				},
				"output_file": {
					"type": "string",
					"description": "JSON file with the terminal layout (\"width\", \"show_time\")."
				},
				"servers": {
					"type": "array",
					"description": "MCP servers whose tools the model gets.",
					"items": {"$ref": "#/definitions/client_server"}
				}
			},
			"required": ["log_level", "servers"],
			"additionalProperties": false
		},

		"client_server": {
			"type": "object",
			"required": ["server_id", "description", "transport"],
			"properties": {
				"enabled": {
					"type": "boolean",
					"description": "Set false to skip this entry.",
					"default": true
				},
				"server_id": {
					"type": "string",
					"description": "Unique identifier for the server."
				},
				"description": {
					"type": "string",
					"description": "The server's role."
				},
				"transport": {
					"type": "string",
					"enum": ["HTTP", "STDIO"],
					"description": "Transport type: HTTP or STDIO."
				},
				"health_check_interval": {
					"type": "number",
					"minimum": 0,
					"description": "Seconds between automatic health checks."
				},
				"capabilities": {
					"type": "object",
					"description": "Server-specific capabilities.",
					"properties": {
						"requires_session": {
							"type": "boolean",
							"description": "Whether this server requires session_id handling.",
							"default": false
						},
						"initialize_via": {
							"type": "string",
							"enum": ["rpc", "sse"],
							"description": "How the initialize RPC is sent: 'rpc' (default) or 'sse'.",
							"default": "rpc"
						}
					},
					"additionalProperties": false
				},
				"config": {
					"description": "How to reach the server. An HTTP entry without it uses the server section's address and port.",
					"oneOf": [
						{
							"type": "object",
							"required": ["url"],
							"properties": {
								"url": {
									"type": "string",
									"format": "uri",
									"description": "Base URL of the MCP HTTP server."
								},
								"headers": {
									"type": "object",
									"additionalProperties": {"type": "string"},
									"description": "HTTP headers."
								},
								"sse_url": {
									"type": "string",
									"format": "uri",
									"description": "SSE endpoint URL."
								}
							},
							"additionalProperties": false
						},
						{
							"type": "object",
							"required": ["command"],
							"properties": {
								"command": {
									"type": "array",
									"items": {"type": "string"},
									"minItems": 1,
									"description": "Subprocess command and arguments."
								},
								"env": {
									"type": "object",
									"additionalProperties": {"type": "string"},
									"description": "Environment variables for the subprocess."
								}
							},
							"additionalProperties": false
						}
					]
				}
			},
			"if": {"properties": {"transport": {"const": "STDIO"}}},
			"then": {"required": ["config"]},
			"additionalProperties": false
		}
	}
}
