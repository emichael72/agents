{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCPAgent Configuration",
  "description": "Validates mcpagent.json: the settings of MCPAgent (python mcp/agent.py) and of the MCP server it starts. Paths are relative to the repository root.",
  "type": "object",
  "properties": {
    "description": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the file holds, one line per item."
    },
    "log_level": {
      "type": "string",
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR"
      ],
      "description": "Logging level of the agent's MCP client."
    },
    "instructions_file": {
      "type": "string",
      "description": "JSON file whose \"instructions\" lines form the model's instructions."
    },
    "agent_instructions_file": {
      "type": "string",
      "description": "JSON file with this agent's \"name\" and its own \"instructions\" lines, added to the shared ones."
    },
    "models_file": {
      "type": "string",
      "description": "JSON file with the model profiles (\"default\" and \"profiles\")."
    },
    "output_file": {
      "type": "string",
      "description": "JSON file with the terminal layout (\"width\", \"show_time\")."
    },
    "agent_file": {
      "type": "string",
      "description": "JSON file with the agent loop settings (\"max_tool_calls\")."
    },
    "tools_dir": {
      "type": "string",
      "description": "Folder of <tool>/tool.json manifests, relative to the repository root."
    },
    "tools_env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Environment variables added to every tool."
    },
    "tools": {
      "type": "object",
      "description": "Extra inline tool definitions, shaped like tool.json manifests."
    },
    "server_output": {
      "type": "boolean",
      "description": "Show the started server's log lines with the agent's other gray lines (with -d). Default false."
    },
    "servers": {
      "type": "array",
      "description": "MCP servers whose tools the model gets; a STDIO entry without config is the agent's own server.",
      "items": {
        "$ref": "#/definitions/client_server"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "client_server": {
      "type": "object",
      "required": [
        "server_id",
        "description",
        "transport"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Set false to skip this entry.",
          "default": true
        },
        "server_id": {
          "type": "string",
          "description": "Unique identifier for the server."
        },
        "description": {
          "type": "string",
          "description": "The server's role."
        },
        "transport": {
          "type": "string",
          "enum": [
            "HTTP",
            "STDIO"
          ],
          "description": "Transport type: HTTP or STDIO."
        },
        "health_check_interval": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds between automatic health checks."
        },
        "capabilities": {
          "type": "object",
          "description": "Server-specific capabilities.",
          "properties": {
            "requires_session": {
              "type": "boolean",
              "description": "Whether this server requires session_id handling.",
              "default": false
            },
            "initialize_via": {
              "type": "string",
              "enum": [
                "rpc",
                "sse"
              ],
              "description": "How the initialize RPC is sent: 'rpc' (default) or 'sse'.",
              "default": "rpc"
            }
          },
          "additionalProperties": false
        },
        "config": {
          "description": "How to reach the server. A STDIO entry without it is the agent's own server, started as a child process.",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Base URL of the MCP HTTP server."
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "HTTP headers."
                },
                "sse_url": {
                  "type": "string",
                  "format": "uri",
                  "description": "SSE endpoint URL."
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "description": "Subprocess command and arguments."
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Environment variables for the subprocess."
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "if": {
        "properties": {
          "transport": {
            "const": "HTTP"
          }
        }
      },
      "then": {
        "required": [
          "config"
        ]
      },
      "additionalProperties": false
    }
  }
}
