// MCPAgent configuration: the MCP server (python mcp/server.py) and the agent that uses it
// (python mcp/client.py). Validated against schemas/mcpagent.schema (next to this file).
// Paths are relative to the repository root.
{
  // The MCP server: serves the shared agents/tools folder over MCP.
  "server": {
    "project_name": "MCP Agent",
    "description": "Serves the shared agents/tools folder over MCP.",
    "version": "1.0.0",

    // Listener address and port; use "0.0.0.0" to bind to all interfaces.
    "mcp_server_port": 6275,
    "mcp_server_bind_address": "127.0.0.1",

    // Print example curl commands on startup.
    "show_usage_examples": false,

    // Tool manifests and working directories; each tool is named after its folder.
    "tools_dir": "tools",

    // Identify this agent to the shared tools.
    "tools_env": {"AGENT_NAME": "MCP Agent"}
  },

  // The agent: which MCP servers it uses, and the shared context that drives the model.
  "client": {
    "log_level": "ERROR",
    "debug_json_box": false,

    // Instructions (system prompt) for the model, shared by all three agents.
    "instructions_file": "context/instructions.json",

    // Model profiles, shared by all three agents.
    // Use --profile, --local or --openai to pick one; otherwise the file's "default" is used.
    "models_file": "context/models.json",

    // Terminal layout (wrap width, response time), shared by all three agents.
    "output_file": "context/output.json",

    // Agent loop settings (max_tool_calls), shared by all three agents.
    "agent_file": "context/agent.json",

    // An HTTP server without "config" is the server above, at its address and port.
    "servers": [{
      "server_id": "tools",
      "description": "The shared agents/tools folder, served by the server section above.",
      "enabled": true,
      "transport": "HTTP"
    }]
  }
}
