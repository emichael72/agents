// MCP Agent server configuration: serves the shared agents/tools folder over MCP.
// Validated against schemas/server.schema when that file exists.
{
  "project_name": "MCP Agent",
  "description": "Serves the shared agents/tools folder over MCP.",
  "version": "1.0.0",

  // Listener address and port; use "0.0.0.0" to bind to all interfaces.
  "mcp_server_port": 6275,
  "mcp_server_bind_address": "127.0.0.1",

  // Display usage examples or write a VS Code MCP configuration on startup.
  "show_usage_examples": false,
  "patch_vscode_config": false,

  // Tool manifests and working directories, relative to this file.
  "tools_dir": "../../../tools",
  "tools_prefix": null,

  // Identify this agent to the shared tools.
  "tools_env": {"AGENT_NAME": "MCP Agent"}
}
