# Single ignore file for the whole repository; do not add nested .gitignore files.

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Node (rebuilt from package-lock.json with `npm ci`)
node_modules/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets
.env
.env.*

# Logs
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# pr gatekeeper: quiz database, answer keys and access password
gatekeepers/pr/data/

# Agents' memory: local notes, not committed (only the README is)
memory/*
!memory/README.md
